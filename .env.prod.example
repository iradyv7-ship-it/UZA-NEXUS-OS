# Copy to .env.prod ON THE SERVER and fill in. Never commit the filled version —
# .env.prod is gitignored.

# The hostname Caddy will get a certificate for. Point an A record at the server first;
# certificate issuance fails if DNS does not already resolve here.
NEXUS_DOMAIN=nexus.uzasolutions.rw

# Database. Choose a long random password; nothing but the API ever connects.
POSTGRES_USER=uza
POSTGRES_PASSWORD=
POSTGRES_DB=uza_nexus

# Signs the session tokens. Generate with:  openssl rand -base64 48
# Changing it later signs everyone out; it is not a rotation you do casually.
JWT_SECRET=

# Optional — without it the register works and only the two advisor routes return 503.
ANTHROPIC_API_KEY=

# Intake sources. Leave blank on the server: the Claude Code transcripts and the working
# documents repository are on the founder's laptop, not on this machine.
UZA_DOCS_DIR=
CLAUDE_PROJECTS_DIR=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=
