# UZA Nexus web.
#
# Next.js standalone output, so the runtime image carries the server and only the
# node_modules the build actually traced — not the whole workspace.
#
# UZA_API_URL is baked at build time by next.config.mjs (it uses `env:`, which inlines
# rather than reading at runtime), so it is passed as a build arg. In compose the API is
# reachable as http://api:3000 on the internal network and is never published to the host.

FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/web/package.json ./apps/web/
# `--ignore-scripts` is deliberate, not a workaround for a warning.
#
# pnpm 11 treats un-approved dependency build scripts as a fatal error, and the approval
# list is recorded in a local node_modules state file that a clean container does not
# have. Skipping lifecycle scripts entirely is the honest resolution rather than the
# convenient one: nothing here needs them. Prisma's client is generated by an explicit
# `prisma generate` below, and @swc/core, esbuild and msgpackr ship prebuilt platform
# binaries as optional dependencies rather than compiling on install. Verified in a clean
# alpine container: install succeeds, the client generates, and @swc-node/register loads.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @uza/web... --filter @uza/contracts

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
ARG UZA_API_URL=http://api:3000
ENV UZA_API_URL=$UZA_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts ./packages/contracts
COPY apps/web ./apps/web
WORKDIR /app/apps/web
RUN pnpm build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3100
# Next writes the standalone server plus a pruned node_modules; static assets and public
# files are not included in it and have to be copied alongside.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3100
CMD ["node", "apps/web/server.js"]
