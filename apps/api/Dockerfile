# UZA Nexus API.
#
# The API runs from TypeScript via @swc-node/register — the same path `pnpm dev` uses —
# rather than a compiled dist. That is a deliberate choice for this deployment: the repo
# has no build script for the API, and adding one to get a marginally faster cold start
# would be a change to how the code runs, made during a deployment, which is the worst
# time to make it. Startup cost is a few hundred milliseconds on a long-lived process.
#
# Two stages so the runtime image does not carry the pnpm store or build toolchain.

FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /app

# Manifests first, so a dependency install is only redone when a manifest changes.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/api/package.json ./apps/api/
# `--ignore-scripts` is deliberate, not a workaround for a warning.
#
# pnpm 11 treats un-approved dependency build scripts as a fatal error, and the approval
# list is recorded in a local node_modules state file that a clean container does not
# have. Skipping lifecycle scripts entirely is the honest resolution rather than the
# convenient one: nothing here needs them. Prisma's client is generated by an explicit
# `prisma generate` below, and @swc/core, esbuild and msgpackr ship prebuilt platform
# binaries as optional dependencies rather than compiling on install. Verified in a clean
# alpine container: install succeeds, the client generates, and @swc-node/register loads.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @uza/api... --filter @uza/contracts

FROM node:22-alpine AS runtime
RUN corepack enable
# openssl is required by Prisma's query engine on alpine.
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts ./packages/contracts
COPY apps/api ./apps/api

WORKDIR /app/apps/api
RUN pnpm exec prisma generate

# Migrations run at start, not at build: the database does not exist at build time, and a
# deploy that ships code without its schema change is how a service comes up broken.
# `migrate deploy` only applies committed migrations and never prompts or resets.
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node -r @swc-node/register src/main.ts"]
