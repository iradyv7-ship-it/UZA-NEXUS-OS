// UZA Nexus OS — platform-core (Sprint 0)
// Owns: identity, roles, authorisation audit, append-only audit log,
// the transactional outbox, processed-events (idempotency) and notifications.
//
// Money is never stored here as a float. Where a minor-unit amount is needed by a
// downstream module it is a BigInt/Int carried in an event payload, never a Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Top-level tenant (UZA Solutions Ltd). Multi-org is modelled from day one so the
/// "internal-only year one?" founder decision does not force a schema migration later.
model Organisation {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  offices Office[]
}

/// A physical/operational office (RW, GOM, CN-Ningbo ...). Actors carry an office.
model Office {
  id             String @id @default(uuid())
  code           String @unique // e.g. "RW", "GOM", "CN"
  name           String
  organisationId String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  users        User[]

  createdAt DateTime @default(now())
}

enum UserKind {
  employee
  partner
}

enum RoleName {
  ceo
  venture_manager
  china_sourcing
  china_warehouse
  front_office
  finance
  sales_agent
  customer
  logistics_partner
}

/// A principal that can authenticate. Employees, customers and external partners are
/// all Users, differentiated by `kind`. Partner (and customer portal) accounts EXPIRE:
/// `expiresAt` is enforced at authentication time. Scope columns hydrate the
/// `Actor.scope` shape from @uza/contracts.
model User {
  id           String   @id @default(uuid())
  ref          String   @unique // readable id, e.g. AGT-GOM-0021 (ID_PATTERNS)
  email        String   @unique
  passwordHash String
  role         RoleName
  kind         UserKind @default(employee)
  officeId     String

  // Object-scope, mirrors Actor.scope in @uza/contracts/permissions.ts
  scopeCustomerId   String?
  scopeCustomerIds  String[] @default([])
  scopeShipmentRefs String[] @default([])

  // MFA-ready. No secret material is required to exist; the columns are present so
  // enabling TOTP later is a data change, not a migration.
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  // Partner/customer accounts expire; internal employees leave expiresAt null.
  expiresAt  DateTime?
  disabledAt DateTime?

  // Alternate credentials. Google/OIDC sign-in matches an EXISTING active user by email
  // and issues the same app JWT + Actor as password login — it never changes a user's
  // role or scope, and it never auto-provisions. `googleSub` records the verified Google
  // subject on first Google login so later logins can be strengthened; `authProvider`
  // records which credential last authenticated. Both are additive and nullable/defaulted.
  googleSub    String? @unique
  authProvider String  @default("password")

  office          Office           @relation(fields: [officeId], references: [id])
  roleAssignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Append-only history of who holds which role, and who granted it. Revocation is a
/// new row's `revokedAt`, never a delete.
model RoleAssignment {
  id           String    @id @default(uuid())
  userId       String
  role         RoleName
  assignedById String
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?
  reason       String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum AuditDecision {
  allow
  deny
}

/// APPEND-ONLY. The AuditService only ever inserts. There is no update or delete path
/// in code, and every authorisation denial writes one of these rows BEFORE the throw.
model AuditLog {
  id        String        @id @default(uuid())
  actorId   String
  actorRole String
  resource  String
  action    String
  decision  AuditDecision
  reason    String? // e.g. ACCESS_DENIED_ROLE / ACCESS_DENIED_SCOPE
  targetRef String?
  detail    Json?
  createdAt DateTime      @default(now())

  @@index([actorId])
  @@index([resource, action])
  @@index([createdAt])
}

enum OutboxStatus {
  pending
  published
  failed
}

/// Transactional outbox. A row is written in the SAME transaction as the state change
/// it describes. The worker (apps/worker) polls `pending` rows and publishes them.
/// Events are NEVER emitted directly from a request handler.
model OutboxEvent {
  id          String       @id @default(uuid())
  eventId     String       @unique // idempotency key, also the EventEnvelope.eventId
  name        String // UzaEventName
  actorId     String
  payload     Json
  occurredAt  DateTime
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  lastError   String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
}

/// Idempotency ledger for consumers. A handler records the eventId it has processed;
/// a second delivery of the same eventId is a no-op. `(eventId, consumer)` is unique so
/// independent consumers each process an event exactly once.
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@unique([eventId, consumer])
}

/// Notification dispatch record. Fan-out on an exception writes one row per recipient,
/// each addressed to a role-appropriate audience (see CF-023).
model Notification {
  id          String    @id @default(uuid())
  ref         String    @unique
  audience    String // NotificationAudience
  recipientId String
  subjectRef  String
  body        String
  channel     String    @default("in_app")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId])
}

// ===========================================================================
// trade-flow (Sprint 1) — the commercial spine: enquiry -> confirmed order.
// Owns: Customer, Lead, Request, Project, Task (RACI), Quotation (versioned),
// Order, Installment. Money is stored as integer MINOR units (never Float);
// the `*Minor` suffix marks every such column. Fractions (marginPct, pct) are
// Float because they are ratios, not money. Cross-aggregate links are readable
// refs (String), mirroring the event-driven reference; no relational FKs so the
// aggregates stay independently writable and truncatable.
// ===========================================================================

enum QuotationStatus {
  draft
  approved
  superseded
}

enum OrderStatus {
  awaiting_payment
  procurement_active
  in_transit
  delivered
  cancelled
}

enum InstallmentStatus {
  due
  paid
}

/// A buyer. `completedOrders` drives the payment-schedule tier (>= 3 delivered =
/// established, per policy.ESTABLISHED_AFTER_ORDERS). `ref` is the readable CUS-... id.
model Customer {
  id              String   @id @default(uuid())
  ref             String   @unique
  name            String
  country         String
  phone           String
  agentId         String?
  completedOrders Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId])
}

/// Badiane's real intake: an informal WhatsApp message lands as raw text. It is NOT a
/// structured request yet. `clarified` flips only when a human confirms the AI/agent
/// interpretation (clarifyLead), which is what produces the Request.
model Lead {
  id         String   @id @default(uuid())
  ref        String   @unique
  customerRef String
  agentId    String
  rawText    String
  stage      String   @default("Awareness")
  clarified  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerRef])
}

/// A structured enquiry, produced only after a human confirms a Lead's interpretation.
/// `spec` is the confirmed structured interpretation of the raw WhatsApp text.
model Request {
  id          String   @id @default(uuid())
  ref         String   @unique
  customerRef String
  leadRef     String
  spec        Json
  venture     String   @default("BULK")
  createdAt   DateTime @default(now())

  @@index([customerRef])
  @@index([leadRef])
}

/// The unit of delivery work. Created only from a Request whose Lead is clarified —
/// unstructured text never becomes a project without the human-confirmation step.
model Project {
  id          String   @id @default(uuid())
  ref         String   @unique
  customerRef String
  agentId     String?
  requestRef  String
  name        String
  owner       String
  stage       String   @default("Qualification")
  health      String   @default("green")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerRef])
  @@index([requestRef])
}

/// RACI: `accountable` (one owner, answers for the outcome) and `responsible` (does the
/// work) are separate, mandatory fields — never collapsed into a single assignee.
model Task {
  id          String   @id @default(uuid())
  ref         String   @unique
  projectRef  String
  title       String
  accountable String
  responsible String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectRef])
}

/// Versioned, never edited in place. A revision supersedes its predecessor and bumps
/// `version`; `supersededByRef` chains old -> new. `ladder` is the full CostLadder
/// (Record<CostRung, {estMinor, actMinor}>) as JSON. `marginPct` is the quoted margin at
/// the sell incoterm, LOCKED at approval. `realizedMargin` is computed later from actuals
/// (at DAP) and is a SEPARATE field — the quoted figure is never overwritten.
model Quotation {
  ref                    String          @id
  projectRef             String
  customerRef            String
  agentId                String?
  qty                    Int
  sellIncoterm           String
  ladder                 Json
  supplierUnitCostMinor  Int
  targetPriceMinor       Int
  walkawayPriceMinor     Int
  customerUnitPriceMinor Int
  marginPct              Float
  realizedMargin         Float?
  version                Int             @default(1)
  status                 QuotationStatus @default(draft)
  supersededByRef        String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([projectRef])
  @@index([customerRef])
}

/// A confirmed order. `tier` and the installment schedule are derived at creation from
/// the customer's completed-order count; the schedule is NOT hardcoded. Order stops here
/// for trade — the Invoice is Finance's (Sprint 2).
model Order {
  ref              String      @id
  projectRef       String
  customerRef      String
  agentId          String?
  quotationRef     String
  totalMinor       Int
  tier             String
  status           OrderStatus @default(awaiting_payment)
  commissionAccrued Boolean    @default(false)
  cancelReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  installments Installment[]

  @@index([customerRef])
  @@index([quotationRef])
}

/// One tranche of an order's payment schedule. Generated from scheduleFor +
/// splitInstallments at order creation (parts sum EXACTLY to the total). Marked `paid`
/// only when Finance's payment.verified event lands for its trigger.
model Installment {
  ref         String            @id
  orderRef    String
  trigger     String
  pct         Float
  amountMinor Int
  status      InstallmentStatus @default(due)
  paidEventId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order Order @relation(fields: [orderRef], references: [ref], onDelete: Cascade)

  @@index([orderRef])
}

// ===========================================================================
// sourcing-quality (Sprint 1) — supplier intelligence + quality control.
// Owns: Supplier (EN/CN names, lifecycle, certifications, price/quality history,
// score), Rfq, SupplierQuote, PurchaseOrder, Visit, Inspection (four stages,
// evidence bound to lot+package refs), Capa. Money is integer MINOR units
// (*Minor). Cross-aggregate links are readable refs (String), mirroring trade.
//
// OFFLINE CAPTURE: François works a Ningbo warehouse on poor signal. Every write
// path carries a nullable `clientRequestId` with a UNIQUE constraint. A device
// captures offline with a client-generated UUID and syncs later; a replay of the
// same clientRequestId is a no-op (the service returns the existing row and does
// NOT re-emit its event). This is the retrofit the charter says to design in now.
//
// SUPPLIER SCORE moves only on logged evidence: every change writes a
// SupplierScoreEvent row carrying the delta, the before/after score and the CAUSE.
// The `score` column is never set by hand — only through that append-only ledger.
// ===========================================================================

/// Supplier lifecycle (matches @uza/contracts SupplierLifecycle).
enum SupplierLifecycle {
  Discovered
  Contacted
  PreScreened
  SampleRequested
  SampleApproved
  TrialOrder
  Verified
  Preferred
  StrategicPartner
  Suspended
  Blocked
}

/// A supplier quote's cost basis. EXW keeps inland cost separable; FOB buries it,
/// so the quote is flagged inlandSeparable=false and cannot be compared like-for-like
/// against an EXW quote without acknowledging the buried inland leg.
enum QuoteBasis {
  EXW
  FOB
}

enum PoStatus {
  issued
  in_production
  ready
  shipped
  cancelled
}

enum InspectionStage {
  pre_production
  during_production
  pre_shipment
  warehouse
}

enum InspectionResult {
  pass
  conditional
  fail
}

enum CapaStatus {
  open
  evidence_submitted
  closed
}

/// A factory. EN + CN names (both matter for a China corridor). `score` is a
/// competitive asset and moves ONLY through SupplierScoreEvent — never a hand edit.
model Supplier {
  id                  String            @id @default(uuid())
  ref                 String            @unique
  nameEn              String
  nameZh              String
  country             String            @default("CN")
  lifecycle           SupplierLifecycle @default(Discovered)
  score               Float             @default(0)
  relationshipOwnerId String?
  clientRequestId     String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  certifications SupplierCertification[]
  scoreEvents    SupplierScoreEvent[]
  priceHistory   SupplierPricePoint[]
  qualityHistory SupplierQualityRecord[]

  @@index([lifecycle])
}

/// A supplier certification (ISO, CE, factory audit ...). Part of the intelligence
/// picture: an expired cert is a sourcing signal.
model SupplierCertification {
  id          String    @id @default(uuid())
  supplierRef String
  name        String
  issuer      String?
  number      String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierRef], references: [ref], onDelete: Cascade)

  @@index([supplierRef])
}

/// APPEND-ONLY score ledger. Every point a supplier gains or loses is a row here,
/// carrying the CAUSE (declared-vs-measured variance, defect rate, delivery lateness,
/// packaging failure) and the before/after score. `Supplier.score` is only ever the
/// running total these rows produce. `sourceEventId` links a change to the domain event
/// that drove it (e.g. a warehouse.receiptRecorded eventId) for idempotency + audit.
model SupplierScoreEvent {
  id            String   @id @default(uuid())
  supplierRef   String
  delta         Float
  previousScore Float
  newScore      Float
  cause         String
  causeRef      String?
  detail        Json?
  sourceEventId String?
  createdAt     DateTime @default(now())

  supplier Supplier @relation(fields: [supplierRef], references: [ref], onDelete: Cascade)

  @@index([supplierRef])
  @@index([cause])
}

/// Price history: one row per observed supplier price (from a quote). Kept as its own
/// series so supplier price trends survive even if a quote is superseded.
model SupplierPricePoint {
  id              String    @id @default(uuid())
  supplierRef     String
  quoteRef        String?
  unitCostMinor   Int
  basis           QuoteBasis
  inlandSeparable Boolean
  observedAt      DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierRef], references: [ref], onDelete: Cascade)

  @@index([supplierRef])
}

/// Quality history: one row per recorded inspection outcome, denormalised onto the
/// supplier so their defect record is queryable without walking POs.
model SupplierQualityRecord {
  id            String           @id @default(uuid())
  supplierRef   String
  inspectionRef String           @unique
  poRef         String
  stage         InspectionStage
  result        InspectionResult
  critical      Int
  major         Int
  minor         Int
  recordedAt    DateTime         @default(now())

  supplier Supplier @relation(fields: [supplierRef], references: [ref], onDelete: Cascade)

  @@index([supplierRef])
}

/// A request for quotation against a project. Suppliers answer with SupplierQuotes.
model Rfq {
  id              String   @id @default(uuid())
  ref             String   @unique
  projectRef      String
  detail          Json?
  status          String   @default("open")
  clientRequestId String?  @unique
  createdAt       DateTime @default(now())

  quotes SupplierQuote[]

  @@index([projectRef])
}

/// A supplier's quote. `basis` + `inlandSeparable` record the cost basis so an EXW
/// (inland separable) quote is never silently compared against an FOB (inland buried)
/// one. Money is MINOR units; volumetrics (cbm/kg) are the factory's DECLARED figures.
model SupplierQuote {
  id              String     @id @default(uuid())
  ref             String     @unique
  supplierRef     String
  projectRef      String
  rfqRef          String?
  unitCostMinor   Int
  moq             Int
  leadTimeDays    Int
  unitCbm         Float
  unitKg          Float
  basis           QuoteBasis @default(EXW)
  inlandSeparable Boolean    @default(true)
  clientRequestId String?    @unique
  createdAt       DateTime   @default(now())

  rfq Rfq? @relation(fields: [rfqRef], references: [ref])

  @@index([supplierRef])
  @@index([projectRef])
}

/// A purchase order to a supplier for a confirmed order. `declaredCbm`/`declaredKg`
/// are what the FACTORY says — the first of the three volumetric numbers (declared,
/// measured, billed). Publishing `po.issued` is owned here.
model PurchaseOrder {
  ref             String   @id
  supplierRef     String
  orderRef        String
  quoteRef        String?
  qty             Int
  unitCostMinor   Int
  poTotalMinor    Int
  declaredCbm     Float
  declaredKg      Float
  status          PoStatus @default(issued)
  clientRequestId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visits      Visit[]
  inspections Inspection[]

  @@index([supplierRef])
  @@index([orderRef])
}

/// A factory visit assigned to an inspector (François). One PO can have several visits
/// across the production timeline.
model Visit {
  id              String   @id @default(uuid())
  ref             String   @unique
  poRef           String
  assignedTo      String
  status          String   @default("assigned")
  clientRequestId String?  @unique
  createdAt       DateTime @default(now())

  po          PurchaseOrder @relation(fields: [poRef], references: [ref], onDelete: Cascade)
  inspections Inspection[]

  @@index([poRef])
}

/// An inspection at one of four stages. `result` is DERIVED (critical>0 ⇒ fail;
/// major>2 ⇒ conditional; else pass) — never set by the caller. A critical defect
/// fails and blocks release, no override. `capturedOffline` records that François
/// captured on a phone with no signal and synced later.
model Inspection {
  ref             String           @id
  visitRef        String
  poRef           String
  supplierRef     String
  stage           InspectionStage  @default(pre_shipment)
  critical        Int              @default(0)
  major           Int              @default(0)
  minor           Int              @default(0)
  result          InspectionResult
  inspectorId     String
  capturedOffline Boolean          @default(false)
  clientRequestId String?          @unique
  createdAt       DateTime         @default(now())

  visit    Visit                @relation(fields: [visitRef], references: [ref])
  po       PurchaseOrder        @relation(fields: [poRef], references: [ref])
  evidence InspectionEvidence[]
  capas    Capa[]

  @@index([poRef])
  @@index([supplierRef])
}

/// Inspection evidence (photo, video, measurement) bound to the lot + package refs it
/// documents — NOT stored loose. This is what wins a forwarder or supplier claim later.
/// lotRef/packageRef are nullable because early-stage inspections predate packing
/// (warehouse creates lots/packages in a later sprint); a warehouse-stage inspection
/// carries them.
model InspectionEvidence {
  id            String   @id @default(uuid())
  inspectionRef String
  kind          String
  uri           String
  lotRef        String?
  packageRef    String?
  note          String?
  capturedAt    DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionRef], references: [ref], onDelete: Cascade)

  @@index([inspectionRef])
  @@index([lotRef])
  @@index([packageRef])
}

/// A corrective action, auto-opened when an inspection fails on a critical defect. AI
/// may DRAFT `correctiveAction`; it may not close the CAPA. Closure requires a
/// human-approved PASSING reinspection (`closedByReinspectionRef` + `closedBy`).
model Capa {
  id                     String     @id @default(uuid())
  ref                    String     @unique
  inspectionRef          String
  supplierRef            String
  poRef                  String
  status                 CapaStatus @default(open)
  correctiveAction       String?
  draftedBy              String?
  closedByReinspectionRef String?
  closedBy               String?
  closedAt               DateTime?
  clientRequestId        String?    @unique
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  inspection Inspection @relation(fields: [inspectionRef], references: [ref])

  @@index([supplierRef])
  @@index([inspectionRef])
}

// ===========================================================================
// finance-commission (Sprint 2) — the money half of the corridor.
// Owns: Invoice + its finance-side installment schedule, Payment (proof capture
// and Finance verification), the append-only Commission ledger (accrual /
// clawback / payout), forwarder freight claims, petty cash, and dual-approval
// supplier bank-detail changes.
//
// PRINCIPLES:
//  - Money is integer MINOR units (*Minor), never Float. Fractions (pct,
//    paidFraction) are ratios, not money.
//  - Every balance is a LEDGER, never an in-place edit. A commission dispute is
//    answered by pointing at rows (accrual + clawback both survive), not by a
//    corrected number with no history.
//  - Finance computes the expected installment amounts INDEPENDENTLY from the
//    order.created payload (scheduleFor + splitInstallments — the same policy
//    trade used), so it validates payments without reading trade's tables.
//  - Cross-aggregate links are readable refs (String); no relational FK into
//    trade/sourcing, so the aggregates stay independently writable.
// ===========================================================================

enum InvoiceStatus {
  issued
  part_paid
  paid
  void
}

/// One tranche of an invoice's payment schedule, finance-owned. Regenerated from the
/// order.created payload via splitInstallments so verification can settle a NAMED
/// installment (not an arbitrary amount) without touching trade's Installment rows.
enum FinanceInstallmentStatus {
  due
  settled
}

/// A payment sits pending until a human with the finance role verifies it. AI, the front
/// office and venture managers can never move it out of pending_verification.
enum PaymentStatus {
  pending_verification
  verified
  rejected
}

/// A movement in the commission ledger. NEVER a balance edit — the running balance is the
/// signed sum of these rows. accrual is positive, clawback and payout are negative.
enum CommissionEntryType {
  accrual
  clawback
  payout
}

enum ClaimStatus {
  raised
  submitted
  recovered
  written_off
}

enum PettyCashKind {
  float
  expense
  replenishment
}

enum BankChangeStatus {
  pending_dual_approval
  applied
  rejected
}

/// The customer-facing bill for an order. Created by consuming trade's `order.created`
/// (idempotent on eventId). `totalMinor` and `tier` come from the event; the schedule is
/// derived locally. `commissionAccrued`/`commissionClawedBack` guard the ledger writes.
model Invoice {
  ref                  String        @id
  orderRef             String        @unique
  customerRef          String
  agentId              String?
  totalMinor           Int
  tier                 String
  status               InvoiceStatus @default(issued)
  commissionAccrued    Boolean       @default(false)
  commissionClawedBack Boolean       @default(false)
  sourceEventId        String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  installments InvoiceInstallment[]

  @@index([customerRef])
  @@index([orderRef])
}

/// Finance's own view of the installment schedule. `settled` flips when Finance verifies
/// a payment that covers it. Kept separate from trade's Installment so the modules stay
/// independently writable; trade marks its own copy paid by consuming `payment.verified`.
model InvoiceInstallment {
  ref               String                   @id
  invoiceRef        String
  orderRef          String
  trigger           String
  pct               Float
  amountMinor       Int
  status            FinanceInstallmentStatus @default(due)
  settledByPaymentRef String?
  settledEventId    String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  invoice Invoice @relation(fields: [invoiceRef], references: [ref], onDelete: Cascade)

  @@index([invoiceRef])
  @@index([orderRef])
}

/// A payment against an invoice. Uploading proof only CAPTURES it (status
/// pending_verification) and publishes `payment.proofUploaded`. Verification is a
/// separate, finance-only act that settles a named installment and stamps `verifiedBy`.
model Payment {
  ref             String        @id
  invoiceRef      String
  orderRef        String
  customerRef     String
  amountMinor     Int
  proofRef        String
  targetTrigger   String
  status          PaymentStatus @default(pending_verification)
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  settledInstallmentRef String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([invoiceRef])
  @@index([orderRef])
  @@index([customerRef])
}

/// APPEND-ONLY commission ledger. 2% accrues when the confirmation installment is
/// verified; a cancellation claws it back; a payout is a third row. The balance is the
/// signed sum — no row is ever updated or deleted. `dedupeKey` is a nullable UNIQUE column
/// giving DB-level idempotency for the singular accrual/clawback per order (payout rows
/// leave it null, so an agent may be paid out many times).
model CommissionEntry {
  id            String              @id @default(uuid())
  agentId       String
  orderRef      String
  amountMinor   Int
  type          CommissionEntryType
  reason        String?
  sourceEventId String?
  dedupeKey     String?             @unique
  createdAt     DateTime            @default(now())

  @@index([agentId])
  @@index([orderRef])
}

/// A claim against a forwarder for over-billing: billed revenue-ton exceeded measured
/// beyond `BILLING_CLAIM_THRESHOLD`. Raised by finance (never a client conversation),
/// with Finance notified. Consumes logistics' `shipment.billedWeightRecorded`.
model ForwarderClaim {
  ref                String      @id
  shipmentRef        String
  measuredRevenueTon Float
  billedRevenueTon   Float
  overRevenueTon     Float
  freightPaidMinor   Int?
  status             ClaimStatus @default(raised)
  sourceEventId      String?     @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([shipmentRef])
}

/// Petty cash movements per office. Append-only ledger; the office balance is the signed
/// sum. `float` seeds the tin, `expense` is negative spend, `replenishment` tops it up.
model PettyCashTransaction {
  ref         String        @id
  office      String
  amountMinor Int
  kind        PettyCashKind
  memo        String
  actorId     String
  createdAt   DateTime      @default(now())

  @@index([office])
}

/// The active bank account we pay a supplier into. Only ever written by applying a
/// dual-approved change request — there is no direct setter.
model SupplierBankAccount {
  supplierRef      String   @id
  accountName      String
  iban             String
  bankName         String
  appliedByRequest String?
  updatedAt        DateTime @updatedAt
}

/// A proposed change to a supplier's bank details. It applies ONLY after two DISTINCT
/// finance approvers approve it, and the requester may not self-approve. This is the
/// dual-approval control on where supplier money goes.
model SupplierBankChangeRequest {
  ref         String           @id
  supplierRef String
  accountName String
  iban        String
  bankName    String
  requestedBy String
  status      BankChangeStatus @default(pending_dual_approval)
  appliedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  approvals SupplierBankChangeApproval[]

  @@index([supplierRef])
}

/// One approver's approval of a bank-change request. `(requestRef, approverId)` is unique
/// so one person cannot approve twice to fake dual approval.
model SupplierBankChangeApproval {
  id         String   @id @default(uuid())
  requestRef String
  approverId String
  createdAt  DateTime @default(now())

  request SupplierBankChangeRequest @relation(fields: [requestRef], references: [ref], onDelete: Cascade)

  @@unique([requestRef, approverId])
  @@index([requestRef])
}

// ===========================================================================
// logistics-warehouse (Sprint 3) — the physical chain and the last real control
// point over an order: goods in the warehouse, not yet on a vessel.
// Owns: WarehouseReceipt (the lot-level three-way volumetric record), Package,
// Shipment (the container), FreightAllocation (per-container P&L), TrackingEvent,
// Delivery, plus locally-projected consumer state (OrderPaymentState, InspectionOutcome).
//
// The single most important rule (CF-014): `qcReleased` (QC state) and
// `varianceHold` (commercial hold) are TWO SEPARATE boolean columns on Package.
// They are NEVER collapsed into one status/zone column. Collapsing them once let
// unresolved goods sail.
//
// Volumetrics are three numbers, never one: declared (factory, on WarehouseReceipt
// from the PO), measured (François, the Package kg/cbm and the receipt's measured*),
// billed (forwarder, on Shipment). No column is overwritten by another number.
//
// Money is integer MINOR units (`*Minor`). Cross-aggregate links are readable refs
// (String), mirroring trade/sourcing/finance; no relational FKs across aggregates so
// the modules stay independently writable and truncatable.
// ===========================================================================

/// Physical staging zone. Deliberately does NOT encode QC state or the commercial
/// hold — those are the separate qcReleased/varianceHold booleans on Package (CF-014).
enum WarehouseZone {
  AWAITING_INSPECTION
  READY_FOR_LOADING
  QUARANTINE
  AWAITING_CORRECTION
  FRAGILE
}

enum Destination {
  KIGALI
  GOMA
  BUKAVU
  UZA_STOCK
  OTHER
}

/// A tracking event's provenance. A customer must never be shown an estimate as if it
/// were confirmed (CF-022): carrier/partner/uza are confirmed, estimated is not.
enum TrackingSource {
  carrier
  partner
  uza
  estimated
}

enum ShipmentStatus {
  planned
  in_transit
  delayed
  arrived
  delivered
}

enum DeliveryStatus {
  planned
  in_progress
  delivered
  failed
}

/// The lot-level warehouse receipt: the three-way volumetric reconciliation record.
/// `declared*` is the factory number (copied from the PO, never mutated here);
/// `measured*` is François's number at the warehouse. `variance` = (measuredCbm -
/// declaredCbm)/declaredCbm. Beyond CBM_HARD_STOP the goods freeze (varianceHold on the
/// packages) until a human records a `decision` (CF-013). Declared-vs-measured is a
/// SUPPLIER problem — the warehouse.receiptRecorded event feeds the supplier score.
model WarehouseReceipt {
  ref                String    @id
  orderRef           String
  poRef              String
  customerRef        String
  lotRef             String    @unique
  declaredCbm        Float
  declaredKg         Float
  measuredCbm        Float
  measuredKg         Float
  measuredRevenueTon Float
  variance           Float
  discrepancy        Boolean
  hardStop           Boolean
  decision           String? // VarianceDecision: client_pays | uza_absorbs | reduce_qty
  decidedBy          String?
  decidedNote        String?
  decidedAt          DateTime?
  clientRequestId    String?   @unique // offline-capture idempotency (François, poor signal)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  packages Package[]

  @@index([orderRef])
  @@index([poRef])
}

/// A physical package (carton/pallet) received into the warehouse. `kg`/`cbm` are the
/// MEASURED numbers (François), never the declared or billed ones. `qcReleased` and
/// `varianceHold` are DELIBERATELY separate booleans (CF-014): releasing QC must not
/// clear a commercial hold, and clearing a hold must not release QC.
model Package {
  ref          String        @id
  orderRef     String
  customerRef  String
  poRef        String
  lotRef       String
  kg           Float
  cbm          Float
  destination  Destination?
  zone         WarehouseZone @default(AWAITING_INSPECTION)
  qcReleased   Boolean       @default(false)
  varianceHold Boolean       @default(false)
  shipmentRef  String?
  delivered    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  receipt WarehouseReceipt @relation(fields: [lotRef], references: [lotRef], onDelete: Cascade)

  @@index([orderRef])
  @@index([lotRef])
  @@index([shipmentRef])
}

/// A shipment == a booked container. Containers are destination-PURE (CF-018): one
/// container, one destination. `billedRevenueTon`/`freightPaidMinor` are the FORWARDER's
/// numbers (the third of the three) recorded after booking; the measured numbers live on
/// the packages. `daysWaitingForConsolidation` is logged on every shipment from day one
/// (the container-utilisation founder decision) so the destination-pure policy can be judged.
model Shipment {
  ref                         String         @id
  container                   String
  carrier                     String
  destination                 Destination
  etd                         String
  eta                         String
  status                      ShipmentStatus @default(planned)
  partnerId                   String?
  billedRevenueTon            Float?
  measuredRevenueTon          Float?
  freightPaidMinor            Int?
  daysWaitingForConsolidation Int            @default(0)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  allocations FreightAllocation[]

  @@index([partnerId])
}

/// Per-container freight P&L. Freight allocates PRO-RATA by revenue ton, `max(cbm,
/// kg/1000)`, not by CBM (CF-021). One row per order on the container; the rows sum
/// EXACTLY to freightPaidMinor (remainder to the last, like splitInstallments).
model FreightAllocation {
  id          String   @id @default(uuid())
  shipmentRef String
  orderRef    String
  revenueTon  Float
  amountMinor Int
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentRef], references: [ref], onDelete: Cascade)

  @@unique([shipmentRef, orderRef])
  @@index([shipmentRef])
}

/// A tracking milestone on a shipment. `source` declares provenance (CF-022): an
/// estimated milestone must never be presented to a customer as confirmed.
model TrackingEvent {
  ref         String         @id
  shipmentRef String
  milestone   String
  source      TrackingSource
  occurredAt  DateTime
  note        String?
  createdAt   DateTime       @default(now())

  @@index([shipmentRef])
}

/// Proof-of-delivery record. Created only after the release gate passes: goods release
/// requires FULL payment (CF-028), not merely arrival.
model Delivery {
  ref         String         @id
  shipmentRef String
  orderRef    String
  customerRef String
  packageRefs String[]
  podRef      String
  status      DeliveryStatus @default(delivered)
  createdAt   DateTime       @default(now())

  @@index([shipmentRef])
  @@index([orderRef])
}

/// Locally-projected order payment state, built by consuming finance's `payment.verified`
/// (never by reading finance tables). Feeds booking gate 2 (pre-loading installment paid)
/// and the release gate (full payment, CF-028). `paidTriggers` is the set of settled
/// installment triggers; `paidFraction` is the cumulative fraction paid.
model OrderPaymentState {
  orderRef     String   @id
  paidFraction Float    @default(0)
  paidTriggers String[]
  updatedAt    DateTime @updatedAt
}

/// Locally-projected quality state per PO, built by consuming `inspection.recorded` /
/// `quality.failed`. The QC-release gate reads it: a package on a PO whose latest
/// inspection failed cannot be released. Kept SEPARATE from the commercial varianceHold.
model InspectionOutcome {
  poRef          String   @id
  lastResult     String // pass | conditional | fail
  releaseBlocked Boolean  @default(false)
  critical       Int      @default(0)
  major          Int      @default(0)
  minor          Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// ===========================================================================
// Nexas Command Center (v1) — the structured foundation of the business-
// management brain. Owns: Departments + light org (EmployeeProfile links an
// internal User to a department + optional manager), management Tasks (distinct
// from trade's RACI project Task), and the Grant pipeline. Authorisation is a
// MODULE-LOCAL policy (command-access.ts) enforced at the service layer, audited
// on denial — @uza/contracts ROLE_GRANTS does not cover these resources.
//
// Money (grant amounts) is integer MINOR units, never a Float. Cross-module
// links (linkedRef) are free readable-ref strings, mirroring the rest of the app.
// ===========================================================================

enum CommandTaskPriority {
  low
  medium
  high
  urgent
}

enum CommandTaskStatus {
  todo
  in_progress
  blocked
  done
  cancelled
}

enum GrantStatus {
  identified
  preparing
  submitted
  awarded
  rejected
  closed
}

/// A department in the org (e.g. Trade, Sourcing, Finance). Lightweight: name + a
/// unique short code. Gives management visibility of who sits where.
model Department {
  id        String   @id @default(uuid())
  ref       String   @unique // readable id, e.g. DPT-TRADE
  code      String   @unique // short code, e.g. TRADE
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members EmployeeProfile[]
}

/// Links an internal User (by their readable `ref`, the Actor.userId) to a department
/// and an optional manager (also a User ref). Additive to the platform User — no column
/// was added to User, keeping identity's schema pristine. One profile per user.
model EmployeeProfile {
  id           String   @id @default(uuid())
  userId       String   @unique // User.ref / Actor.userId
  departmentId String?
  managerId    String? // manager's User.ref / Actor.userId
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([managerId])
}

/// A management task — the executive-layer unit of "what needs doing". Distinct from
/// trade's RACI project Task: this one carries a single assignee, cross-department reach,
/// priority/status, an optional due date, an optional free `linkedRef` to any UZA Nexus
/// record (order/supplier/…), and optional subtasks via `parentTaskId`.
model CommandTask {
  ref          String              @id // readable id, e.g. CTSK-2026-0001
  title        String
  description  String?
  assigneeId   String // User.ref of the assignee (may be anyone, cross-department)
  departmentId String?
  priority     CommandTaskPriority @default(medium)
  status       CommandTaskStatus   @default(todo)
  dueAt        DateTime?
  createdById  String // User.ref of the creator
  linkedRef    String? // free ref to any UZA Nexus record (order/supplier/etc.)
  parentTaskId String? // parent CommandTask.ref for subtasks
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([assigneeId])
  @@index([departmentId])
  @@index([createdById])
  @@index([status])
  @@index([parentTaskId])
}

/// A grant-pipeline opportunity with deadline awareness. `amountMinor` is integer minor
/// units of `currency`. `requirements` is a JSON checklist ([{item, done}]). `ownerId` is
/// the assigned owner's User.ref — an owner may see/update their own grant even without
/// the ceo/venture_manager role.
model Grant {
  ref          String      @id // readable id, e.g. GRNT-2026-0001
  name         String
  funder       String
  amountMinor  Int
  currency     String // e.g. USD, RWF
  deadlineAt   DateTime?
  status       GrantStatus @default(identified)
  fitNotes     String?
  nextAction   String?
  ownerId      String? // assigned owner's User.ref
  requirements Json     @default("[]") // [{ item: string, done: boolean }]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([deadlineAt])
}

// ===========================================================================
// Nexas Planning & Reviews (v1) — the OKR-style cascading-plan + weekly-rhythm
// + KPI backbone that lets the CEO run the company ON PURPOSE and track growth.
// Owns: Initiatives (the portfolio unit — the mother company + each project,
// internal OR client), Plans (the quarter→month→week cascade of objectives),
// WeeklyReports (the operating rhythm), and KPIs + their time-series values.
// Authorisation is a MODULE-LOCAL policy (planning-access.ts) enforced at the
// service layer and audited on denial — @uza/contracts ROLE_GRANTS does not
// model these resources. Object-scope (own vs department vs all) mirrors the
// Command Center: separate from the role gate, mirrored between read and list.
//
// KPI values are GENERIC floats (a KPI may be a count, a %, a rating, or money;
// if it represents money the unit string is the caller's — no minor-unit
// discipline is imposed on a free metric). Cross-module links (initiativeRef,
// planRef, parentPlanRef) are free readable-ref strings like the rest of the app.
// ===========================================================================

enum InitiativeKind {
  internal
  client
  /// A line of business in its own right — charging, the garage, Tunga Taxi. Neither an
  /// internal project nor a single client engagement, and it needs to be countable
  /// separately or the register cannot tell a venture from a to-do. (added 2026-08-21)
  venture
}

enum InitiativeStatus {
  active
  paused
  done
  cancelled
}

enum PlanLevel {
  quarter
  month
  week
}

enum PlanStatus {
  draft
  active
  done
}

enum KpiDirection {
  up_good
  down_good
}

/// A portfolio unit: the UZA mother company or a single project (internal OR a
/// client engagement). Plans, KPIs and (management) tasks can reference an
/// initiative by its readable `ref`. `ownerId` is the accountable User.ref;
/// `departmentId` optionally anchors it in the org for department-scoped reads.
model Initiative {
  ref          String           @id // readable id, e.g. INIT-2026-0001
  name         String
  kind         InitiativeKind
  clientName   String? // set when kind = client
  ownerId      String // accountable User.ref
  departmentId String?
  status       InitiativeStatus @default(active)
  startedAt    DateTime?
  targetDate   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // --- the register (added 2026-08-21) -------------------------------------
  // `status` is LIFECYCLE (is this thing alive?). `attention` is ALLOCATION
  // (is it getting weekly time?). They are genuinely different: an initiative
  // can be active and on hold at the same time, and conflating them is how a
  // register stops telling the truth.
  attention   AttentionState @default(holds)
  ventureCode String? // GROUP | BULK | MOBILITY | EMPOWER | CLOUD | NEXUS

  /// One line. An initiative without a next action is a wish — the service
  /// refuses to set attention=runs while this is empty, and the index below
  /// makes "which initiatives have no next action" a one-query report.
  nextAction String?

  /// When a held initiative is looked at again. On that date it is started or
  /// the date moves; it is never simply forgotten. Null while attention=runs.
  reviewAt DateTime?

  artifactUrl String? // the published document that settles this initiative

  /// Set when status moves to done or cancelled. Kept separate from updatedAt so
  /// "when did we stop" survives later edits to the record.
  closedAt DateTime?

  decisions ExecDecision[]
  checkins  InitiativeCheckin[]

  @@index([kind])
  @@index([status])
  @@index([ownerId])
  @@index([departmentId])
  @@index([attention])
  @@index([reviewAt])
  @@index([ventureCode, attention])
}

/// A plan in the cascade. An employee (`ownerId`) owns a `quarter`, `month` or
/// `week` plan for a `periodKey` (e.g. 2026-Q3 / 2026-08 / 2026-W32). A week
/// plan may name its month plan as `parentPlanRef`, a month plan its quarter
/// plan — the cascade is validated (same owner, correct parent level) when the
/// parent is supplied. `objectives` is a JSON list of { text, status } where
/// status ∈ not_started | in_progress | done | dropped.
model Plan {
  ref           String     @id // readable id, e.g. PLAN-2026-0001
  ownerId       String // the employee's User.ref
  level         PlanLevel
  periodKey     String // e.g. 2026-Q3, 2026-08, 2026-W32
  parentPlanRef String? // week → month → quarter Plan.ref
  initiativeRef String? // optional Initiative.ref this plan advances
  objectives    Json       @default("[]") // [{ text: string, status: ObjectiveStatus }]
  status        PlanStatus @default(draft)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  weeklyReport WeeklyReport?

  @@unique([ownerId, level, periodKey]) // one plan per owner/level/period
  @@index([ownerId])
  @@index([level])
  @@index([periodKey])
  @@index([parentPlanRef])
  @@index([initiativeRef])
  @@index([status])
}

/// The weekly operating rhythm: exactly one report per week Plan. Captures what
/// happened (`highlights`), what is stuck (`blockers`) and the intent for next
/// week (`nextWeek`). `planRef` is unique so a week has a single report.
model WeeklyReport {
  ref         String   @id // readable id, e.g. WRPT-2026-0001
  planRef     String   @unique // the week Plan.ref
  ownerId     String // the employee's User.ref (mirrors the plan owner)
  periodKey   String // the week key, e.g. 2026-W32
  highlights  String
  blockers    String?
  nextWeek    String?
  /// What this person needs FROM someone else this week. Free text, deliberately separate
  /// from `blockers`: a blocker is something in the way, an ask is a trade. The ask is the
  /// field that turns a status meeting into one people want to attend, so it is captured
  /// even when nothing is blocked.
  asking      String?
  submittedAt DateTime @default(now())

  plan     Plan      @relation(fields: [planRef], references: [ref], onDelete: Cascade)
  raised   Blocker[]

  @@index([ownerId])
  @@index([periodKey])
}

/// A tracked metric. `direction` says which way is good (up_good | down_good).
/// `target` is an optional threshold. Values are GENERIC floats (see the module
/// header). `ownerId`/`departmentId`/`initiativeRef` anchor it for scoped reads.
model Kpi {
  ref           String       @id // readable id, e.g. KPI-2026-0001
  name          String
  unit          String // e.g. "USD", "%", "orders", "rating"
  direction     KpiDirection @default(up_good)
  target        Float?
  ownerId       String?
  departmentId  String?
  initiativeRef String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  values KpiValue[]

  @@index([ownerId])
  @@index([departmentId])
  @@index([initiativeRef])
}

/// One point in a KPI's time series: the metric's `value` (a generic Float) for
/// a `periodKey`. Ordered by `recordedAt` to read the trend.
model KpiValue {
  ref        String   @id // readable id, e.g. KVAL-2026-00001
  kpiRef     String
  periodKey  String // e.g. 2026-08, 2026-Q3, 2026-W32
  value      Float
  recordedAt DateTime @default(now())

  kpi Kpi @relation(fields: [kpiRef], references: [ref], onDelete: Cascade)

  @@unique([kpiRef, periodKey]) // one value per KPI per period
  @@index([kpiRef])
  @@index([periodKey])
}


// ===========================================================================
// The register's two additions (2026-08-21)
//
// Planning already models Initiative, Plan, WeeklyReport and KPIs. Two things
// the operating model needs were missing, and both are added here rather than
// in a competing module:
//
//   AttentionState — three initiatives run at a time; everything else HOLDS
//                    with a named owner, a next action and a review date.
//   ExecDecision   — what is waiting on the CEO. This table IS the bottleneck
//                    metric, and nothing else in the system reports it honestly.
// ===========================================================================

/// A weekly line from the person accountable for an initiative.
///
/// The Planning module already has `WeeklyReport`, but that one hangs off a week `Plan`
/// and cannot exist until a plan does. The register needs a check-in per initiative with
/// no such precondition — otherwise the honest answer to "did anything move?" is blocked
/// behind paperwork. Both are readable by the CEO review.
///
/// Unique on [initiativeRef, weekOf]: two filings in the same week collide and the second
/// updates the first, rather than both landing and the register showing double progress.
model InitiativeCheckin {
  ref           String   @id // readable id, e.g. CHK-2026-0001
  initiativeRef String
  ownerId       String // User.ref of whoever filed it
  weekOf        DateTime // the Monday of that week, UTC midnight

  /// What actually moved. Required — a check-in that says nothing is not a check-in.
  moved String

  blocked      String?
  /// What this owner needs from the CEO. When set, the review surfaces it next to the
  /// decision queue, because a blocker nobody escalated is the same as no blocker.
  needsFromCeo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  initiative Initiative @relation(fields: [initiativeRef], references: [ref], onDelete: Cascade)

  @@unique([initiativeRef, weekOf])
  @@index([weekOf])
  @@index([ownerId])
}

/// Something that arrived from outside the register and might belong in it.
///
/// Intake watches the places ideas actually appear — Claude Code transcripts, published
/// artifacts, email — and files each one here. A Signal is NEVER an initiative. It is a
/// candidate, and a person promotes it. The advisor may propose; only a human writes to
/// the register, and the same rule governs everything that flows through this table.
///
/// `externalId` is the source's own identifier (a message id, a transcript uuid + offset,
/// an artifact url). Unique with `source` so a sweep that re-reads the same mailbox or the
/// same transcript file does not file the same thing twice — sweeps are expected to
/// overlap, and idempotence is what makes "run it again" safe.
model Signal {
  ref        String       @id // readable id, e.g. SIG-2026-0001
  source     SignalSource
  externalId String // the source's own id, whatever shape it takes
  lane       SignalLane   @default(shared)

  title      String
  /// The raw text as captured. Never shown outside the lane it was classified into.
  body       String
  /// A redacted one-paragraph summary. Phone numbers and national IDs are stripped before
  /// this is written, because this is the field that appears in shared views.
  summary    String?

  /// Terms that triggered a compartmentalisation rule. Recorded even when the signal ends
  /// up shared, so the reason a lane was chosen is auditable after the fact.
  wallTags String[] @default([])

  status SignalStatus @default(new)

  /// What triage thinks this belongs to. A proposal, not a link — note there is no
  /// relation and no foreign key: the register must not gain rows as a side effect of
  /// something arriving in a mailbox.
  proposedInitiativeRef String?
  proposedAction        String?
  /// Model confidence 0..1 from triage. Low confidence is a reason to read it yourself,
  /// not a reason to hide it.
  proposedConfidence    Float?

  /// Set when a human acts on it. `promotedRef` is whatever was created — an initiative,
  /// a decision, a task — recorded as a free ref so intake never has to know which.
  promotedRef     String?
  resolvedById    String?
  resolvedAt      DateTime?
  dismissedReason String?

  occurredAt DateTime // when the thing actually happened at the source
  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status, occurredAt])
  @@index([lane])
  @@index([proposedInitiativeRef])
}

/// A standing duty that belongs to a person — not a task, not a project.
///
/// "Francois verifies documents on every shipment" is true continuously and is never
/// finished. Modelling it as a task produces a hundred identical tasks; modelling it as an
/// initiative produces an initiative that can never be closed. It is a third thing, and
/// the register was missing it: the question "who does document verification, and what
/// happens when they are away" had no answer anywhere in the system.
///
/// Two fields carry the weight:
///
///  - `backupId`. A duty with one name against it is a single point of failure that only
///    reveals itself the week that person is unreachable.
///  - `responseHours`. This is the clock. The observed failure at UZA is not that work is
///    unassigned — it is that work sits waiting on an answer with no agreed time by which
///    the answer is due. An approval without a response time is not a control, it is a
///    queue, and the service refuses to create one.
model Responsibility {
  ref         String @id // readable id, e.g. RESP-2026-0001
  name        String
  ventureCode String? // GROUP | BULK | MOBILITY | EMPOWER | CLOUD | NEXUS

  ownerId  String // User.ref of the person accountable
  backupId String? // who covers when the owner is unreachable

  kind    ResponsibilityKind
  trigger ResponsibilityTrigger @default(ad_hoc)

  /// Hours within which the owner must respond once triggered. Required when
  /// kind = approval; optional elsewhere, where it reads as a service standard.
  responseHours Int?

  notes String?

  /// Set when a duty does not start today — Francois's China verifications begin when he
  /// lands in September. A future-dated duty is visible in the register now, which is the
  /// point: it can be prepared for rather than discovered.
  startsOn DateTime?
  endsOn   DateTime?
  active   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([backupId])
  @@index([ventureCode, active])
  @@index([kind])
}

enum ResponsibilityKind {
  /// A continuous duty: run this, watch this, answer this.
  standing
  /// A check that must pass before work is allowed to proceed.
  gate
  /// Someone has to say yes. Always carries a response time.
  approval
}

enum ResponsibilityTrigger {
  per_shipment
  per_deal
  per_request
  daily
  weekly
  monthly
  ad_hoc
}

/// Every system UZA owns — a repository, a deployed app, a prototype.
///
/// The register says what the company is DOING; this says what it HAS. They are different
/// questions and the second had no answer anywhere: seventeen repositories exist across
/// two GitHub accounts, three of them duplicated, and the only record of which copy is
/// canonical lived in one person's memory.
///
/// `initiativeRef` is a soft link with no foreign key on purpose. Most systems are not
/// attached to a live initiative, and requiring one would either force fake initiatives
/// into the register or keep real systems out of this table. Both are worse than a
/// nullable string.
model SystemRecord {
  ref  String     @id // readable id, e.g. SYS-2026-0001
  name String
  kind SystemKind

  ventureCode String? // GROUP | BULK | MOBILITY | EMPOWER | CLOUD | NEXUS
  ownerId     String // User.ref of whoever answers for it
  status      SystemStatus @default(building)

  repoUrl String?
  liveUrl String?
  /// Whether the source is readable by the public. Recorded because it is a decision that
  /// is almost always made by default rather than on purpose.
  visibility SystemVisibility @default(unknown)

  /// When someone last pushed to it. The single most honest signal of whether a system is
  /// alive, and the only field here that cannot be talked up in a meeting.
  lastPushAt DateTime?

  /// The canonical copy, when the same system exists in more than one place. Set on the
  /// duplicate, pointing at the one to keep.
  supersededBy String?

  initiativeRef String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ventureCode, status])
  @@index([ownerId])
  @@index([status])
}

enum SystemKind {
  repository
  web_app
  mobile_app
  backend
  admin_panel
  prototype
  document
}

enum SystemStatus {
  live // in use by someone outside the team
  building
  prototype
  dormant // nothing has happened for months and nobody is waiting on it
  retired
}

enum SystemVisibility {
  public
  private
  unknown
}

/// A message from the CEO or a project manager to the team, with proof it was read.
///
/// This is not chat, and it should not become chat. Chat is for conversation and UZA
/// already has somewhere for that. A memo is for the thing chat is worst at: something
/// that must reach specific people and be known to have reached them. The receipts are
/// the entire point — an announcement nobody can show was read is a hope.
model Memo {
  ref     String @id // readable id, e.g. MEMO-2026-0001
  subject String
  body    String

  fromId      String // User.ref of the sender
  audience    MemoAudience
  /// Set when audience = department.
  departmentCode String?
  /// Set when audience = person.
  toId           String?
  ventureCode    String?

  /// When true the reader must acknowledge, not merely open it. Use for anything that
  /// changes how someone works — a new rule, a threshold, a deadline.
  needsAck Boolean @default(false)

  /// A memo attached to an initiative or a decision, so the reason is one click away.
  linkedRef String?

  sentAt   DateTime @default(now())
  receipts MemoReceipt[]

  @@index([fromId])
  @@index([sentAt])
  @@index([audience])
}

model MemoReceipt {
  id       String @id @default(uuid())
  memoRef  String
  userRef  String
  readAt   DateTime?
  ackedAt  DateTime?

  memo Memo @relation(fields: [memoRef], references: [ref], onDelete: Cascade)

  @@unique([memoRef, userRef])
  @@index([userRef])
}

enum MemoAudience {
  everyone
  department
  person
}

/// Money being raised, for one thing, from one counterparty.
///
/// The register says what UZA is doing and the estate says what it owns. Neither says what
/// is being raised, from whom, and — the part that has never been written down anywhere —
/// **what unblocks if it closes**.
///
/// That last field is the whole reason this model exists. The founder's strategy is that
/// each venture must stand alone to a funder, and whichever closes first pushes the others
/// forward. That only works if the push is written down before the money arrives, because
/// afterwards everyone has an opinion about where it should go.
///
/// `Grant` already models a grant application and its requirement checklist. This does not
/// replace it: when `instrument = grant`, `grantRef` points at that record and the two are
/// read together. Debt, revolvers, facilities and equity had no home at all.
model FundingTrack {
  ref  String @id // readable id, e.g. FUND-2026-0001
  name String

  instrument  FundingInstrument
  funder      String
  ventureCode String? // which venture it belongs to — null means group-level

  /// Whole currency units, not minor. These are facility-sized numbers where a cent is
  /// noise, and storing 430,000,000 as 43,000,000,000 helps nobody read it.
  amountSought Float
  currency     String  @default("RWF")

  stage   FundingStage @default(identified)
  ownerId String

  /// The initiative refs this money releases. Soft refs, no foreign key: a funding track
  /// routinely unblocks work that has not been entered in the register yet, and refusing
  /// to record the intent until it has is how the intent gets lost.
  unlocks String[] @default([])

  /// What UZA can actually evidence to this funder today. Written honestly or the track is
  /// worthless — the gap between this and what they will ask for IS the work.
  evidence String?
  /// The single thing standing in the way right now.
  blocker  String?

  decisionBy DateTime? // when the funder is expected to decide
  closedAt   DateTime?
  grantRef   String? // set when instrument = grant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([ventureCode, stage])
  @@index([ownerId])
}

enum FundingInstrument {
  grant
  concessional // blended or below-market, e.g. a green facility
  debt // a term loan
  revolver // short-cycle working capital, repaid each turn
  facility // a lender line the programme draws against, e.g. an LC line
  equity
  offtake // not money, but a commitment that makes money raisable
}

enum FundingStage {
  identified
  qualifying // finding out whether UZA is eligible at all
  preparing
  submitted
  in_diligence
  approved
  closed // money available
  declined
  parked
}

enum SignalSource {
  claude_code // a local Claude Code session transcript
  artifact // a published artifact
  email
  manual // typed in by a person
}

enum SignalLane {
  /// Visible to anyone holding intake:read.
  shared
  /// CEO only. Applied automatically by the compartmentalisation rules and never
  /// downgraded except by an explicit executive act.
  private
}

enum SignalStatus {
  new // captured, not yet triaged
  triaged // the advisor has proposed a home for it
  promoted // a human turned it into something in the register
  dismissed
}

enum AttentionState {
  runs // gets weekly time and headcount
  holds // named owner + next action + review date, no weekly time
  parked // deliberately not now, written down so it stops taking up attention
}

enum DecisionStatus {
  open
  answered
  deferred
}

/// Decisions waiting on the CEO. If rows sit open for more than a few days the
/// founder is the constraint — measurably, not as an impression. Raised by
/// anyone, answered only by ceo/venture_manager.
model ExecDecision {
  ref           String         @id // readable id, e.g. DEC-2026-0001
  question      String // stated so it has a decidable answer
  context       String?
  initiativeRef String?
  raisedById    String // User.ref
  raisedAt      DateTime       @default(now())
  status        DecisionStatus @default(open)

  answer     String?
  answeredById String?
  answeredAt DateTime?

  /// A decision may be postponed — but only to a date, never indefinitely.
  deferredTo DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  initiative Initiative? @relation(fields: [initiativeRef], references: [ref])

  @@index([status, raisedAt])
  @@index([initiativeRef])
  @@index([raisedById])
}


// ============================================================
// UMURIMO — the people-and-work layer.
//
// A module INSIDE Nexus with a clean boundary, not a separate deployment: its own access
// policy (`umurimo-access.ts`), its own readable ids (`umurimo-ids.ts`), no direct joins
// across into planning beyond a ref. If it is ever split into its own service, the seam is
// already cut and the move is a folder plus a connection string.
//
// Nexus answers "what is the company doing". Umurimo answers "who is doing it, and how are
// they". These two models are the smallest thing that makes the second question answerable.
// ============================================================

/// One thing standing in someone's way, raised in a weekly review.
///
/// The whole point of this model is `ownerId` and `dueAt` being NULLABLE and SURFACED. A
/// blocker with neither is a complaint; a blocker with both is work. `unowned()` returns the
/// first kind, and the discipline is that none should survive the end of the meeting it was
/// raised in. Storing blockers only as free text on the report — which is what the schema did
/// before — makes that check impossible, which is why this table exists.
model Blocker {
  ref       String @id // readable id, e.g. BLK-2026-0001
  reportRef String // the WeeklyReport it was raised in
  raisedBy  String // User.ref
  summary   String

  /// Who will clear it. NULL is the finding, not an omission.
  ownerId String?
  /// By when. NULL is the finding, not an omission.
  dueAt   DateTime?
  /// Set when someone accepts it, so "raised on Monday, owned on Thursday" stays visible.
  ownedAt DateTime?

  clearedAt   DateTime?
  clearedBy   String?
  clearedNote String?

  createdAt DateTime @default(now())

  report WeeklyReport @relation(fields: [reportRef], references: [ref], onDelete: Cascade)

  @@index([reportRef])
  @@index([ownerId])
  @@index([clearedAt])
  @@index([dueAt])
}

/// Why a thing is the way it is, attached to the thing.
///
/// This is NOT chat. The test applied throughout the module: if the message would be
/// meaningless without knowing which record it concerns, it belongs here; if it makes sense on
/// its own, it belongs in WhatsApp. Polymorphic by (`subjectType`, `subjectRef`) so one table
/// serves initiatives, decisions, reports, blockers and candidate files — but `subjectType` is
/// validated against an allowlist in the service, because an unconstrained polymorphic key
/// becomes a dumping ground within a month.
model Comment {
  ref         String      @id // readable id, e.g. CMT-2026-000123
  subjectType String // validated allowlist — see COMMENT_SUBJECTS
  subjectRef  String // the target record's readable ref
  parentRef   String? // threading; NULL is a root comment
  authorId    String // User.ref
  body        String
  kind        CommentKind @default(comment)

  /// User.refs explicitly asked to look. Drives notification; does not grant access — a
  /// mention never widens what someone may read.
  mentions String[] @default([])

  /// Only meaningful for `kind = request`: an open request is one the team still owes an
  /// answer to, and that set is what the weekly digest surfaces.
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedNote String?

  createdAt DateTime  @default(now())
  editedAt  DateTime?

  parent  Comment?  @relation("CommentThread", fields: [parentRef], references: [ref], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")

  @@index([subjectType, subjectRef, createdAt])
  @@index([authorId])
  @@index([parentRef])
  @@index([kind, resolvedAt])
}

enum CommentKind {
  /// An observation. Nobody owes a reply.
  comment
  /// An explicit request for the team to weigh in. Open until resolved, and surfaced in the
  /// weekly digest until it is.
  request
}


/// A task mirrored FROM the team workspace.
///
/// Nexus does not own this row and must never write a change back into it. The workspace is
/// where work is done; this is a read-only shadow so that Nexus can answer questions a task
/// board structurally cannot — did the week's commitments actually complete, who is silent,
/// what recurs. Observing a system is a different thing from acting in it, and the second
/// requires a decision nobody has made.
///
/// Pushed in rather than fetched out. Push needs no credentials stored in Nexus, works
/// whether the workspace is a UZA build or a third-party product, and fails loudly instead of
/// silently going stale the way a broken poller does.
model WorkspaceTask {
  /// The workspace's own id. Upserts key on this, so re-pushing is safe and idempotent.
  externalId String @id

  title       String
  status      WorkspaceTaskStatus
  project     String?
  priority    String?
  url         String?

  /// Whose it is, as the workspace knows them. Kept verbatim even when it maps to nobody,
  /// because an unmapped assignee is a finding to report, not a row to drop.
  assigneeEmail String?
  /// Resolved User.ref, when an active employee has that email. Null is normal and visible.
  assigneeRef   String?

  createdAtSource DateTime?
  deadline        DateTime?
  completedAt     DateTime?
  /// What the person wrote when they finished it. The most useful field on the whole row.
  completionNote  String?

  /// When Nexus last heard about it. A task that stops being pushed goes stale and is
  /// answerable as such, rather than quietly looking current forever.
  syncedAt DateTime @default(now())

  @@index([assigneeRef, status])
  @@index([status, deadline])
  @@index([project])
  @@index([syncedAt])
}

enum WorkspaceTaskStatus {
  todo
  in_progress
  done
}

// ─────────────────────────────────────────────────────────────────── The UZA ID
//
// One person, one identifier, used by every UZA system: the Mobility platform, the
// candidate portal, the charging platform, the taxi app, the wallet, the battery
// registry and Nexus itself.
//
// WHY THIS IS FEDERATION AND NOT A MERGE
//
// Each satellite system keeps its own user table and its own database. What changes is
// that each one records the person's UZA ID alongside its local row, and Nexus holds the
// map. That means:
//
//   · No destructive migration. Nothing is deleted, nothing is moved, and a system that
//     has not adopted the ID yet simply has no link row — visible as a gap rather than
//     as a wrong answer.
//   · It is reversible. A merge is not.
//   · It can be rolled out one system at a time, which is the only way it will actually
//     happen while five other things are also being launched.
//
// WHY THERE IS NO PERSONAL DATA IN HERE
//
// Nexus holds NO national ID and NO phone number in clear. It holds a peppered hash of
// each, used only to answer "are these two records the same person?", plus a display name
// so a human can read the register. The real values stay in the system that legitimately
// collects them, under the consent given there.
//
// This is not caution for its own sake. Nexus is the one system every employee can reach,
// so it is the worst possible place to concentrate identity documents — and under Law
// N° 058/2021 the obligation follows the data. Not holding it is the strongest control
// available, and it costs nothing here because matching only ever needs equality.

/// A natural person, known to UZA once, across every system.
model Person {
  id          String   @id @default(uuid())
  ref         String   @unique /// the UZA ID, e.g. UZA-P-000123. Permanent.
  displayName String /// for humans reading a register. Not used for matching.

  /// SHA-256 of (normalised value + UZA_ID_PEPPER). Match keys, never identifiers.
  /// The pepper is mandatory: a national ID has a small enough space that an unpeppered
  /// hash is recoverable by brute force in minutes, which would make this table the
  /// identity-document store it exists to avoid being.
  phoneHash      String? @unique
  nationalIdHash String? @unique

  /// Consent to be included in aggregate impact reporting (Law N° 058/2021).
  /// Revocable: withdrawing removes the person from FUTURE aggregates. It cannot rewrite
  /// a report already issued, and intake says so out loud.
  reportingConsent   Boolean   @default(false)
  consentRecordedAt  DateTime?
  consentWithdrawnAt DateTime?

  mergedIntoRef String? /// set when this record was folded into another. Never deleted.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links PersonLink[]

  @@index([mergedIntoRef])
}

/// One person as a given system knows them. The join that makes the UZA ID real.
model PersonLink {
  id         String   @id @default(uuid())
  personRef  String /// Person.ref
  system     String /// e.g. "mobility", "charge", "evfleet", "battery", "nexus", "taxi"
  externalId String /// that system's own primary key or username for this person
  note       String?
  createdAt  DateTime @default(now())

  person Person @relation(fields: [personRef], references: [ref], onDelete: Cascade)

  /// A system may know a person exactly once. This is the constraint that stops the
  /// fragmentation from re-forming: a second link for the same (system, externalId)
  /// fails loudly rather than quietly creating a second identity.
  @@unique([system, externalId])
  @@index([personRef])
}

// ───────────────────────────────────────────────────── Lender disclosure
//
// Which lender may see which borrower, and whether that borrower agreed to it.
//
// Entitlement and consent are deliberately ONE record with two dates rather than two
// tables. A lender is entitled because it has a loan with this person, and the consent it
// holds is consent to THAT lender — the two facts are born together at origination and
// they die together. Splitting them invites a row of one kind without the other, which is
// exactly the state that produces an accidental disclosure.
//
// Under Law N° 058/2021 consent is specific. Agreeing that Unguka may see a file is not
// agreeing that Equity may, so there is one row per (person, lender) and no global
// "consents to lenders" flag anywhere.

/// A lender's entitlement to one borrower's file, and that borrower's consent to it.
model LenderBorrower {
  id        String @id @default(uuid())
  personRef String /// Person.ref — the UZA ID
  lender    String /// normalised lender key, e.g. "unguka", "equity"
  loanRef   String? /// the lender's OWN reference for the loan, for their reconciliation

  /// Null means never given. Consent is affirmative — absence is refusal, not permission.
  consentGivenAt     DateTime?
  /// Set on withdrawal. Kept rather than clearing consentGivenAt, so the record shows that
  /// consent existed and when it ended — which is what an audit or a complaint needs.
  consentWithdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A lender knows a person once. Two rows would mean two answers to "may they see this".
  @@unique([personRef, lender])
  @@index([lender])
}
