# Copy to .env. These match docker-compose.yml.
DATABASE_URL="postgresql://uza:uza_dev_pw@localhost:5432/uza_nexus?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-change-me"
JWT_TTL="3600s"
PORT="3000"

# NOT OPTIONAL, either of these two — see README "Running it, in five minutes".
# UZA_ID_PEPPER: any non-empty string locally. Person matching refuses to hash without it.
# MFA_ENCRYPTION_KEY: any non-empty string locally. TOTP secrets refuse to encrypt/decrypt
# without it (see platform/auth/mfa.ts) — same reasoning as the pepper: a database with an
# unkeyed secret in it is a database with the secret in it.
UZA_ID_PEPPER="test-pepper-not-a-real-secret"
MFA_ENCRYPTION_KEY="dev-only-change-me"

# Where the browser lands after a successful Google sign-in (the web app origin).
WEB_ORIGIN="http://localhost:3100"

# Google / OIDC sign-in (OPTIONAL). Leave any of these unset and the /auth/google
# endpoints answer 503 { "error": "google_signin_not_configured" } — the app still runs.
# Create these in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). The authorized redirect URI MUST equal GOOGLE_CALLBACK_URL exactly.
# NEVER commit real secrets — put the real values only in .env (git-ignored).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# The WEB app's /auth/google/return route (Option A, as shipped) — NOT the API's own
# /auth/google/callback. This is the exact value to register as the redirect URI in
# Google Cloud Console, byte-for-byte.
GOOGLE_CALLBACK_URL="http://localhost:3100/auth/google/return"

# ── Intake ──────────────────────────────────────────────────────────────────
# Where Claude Code keeps session transcripts. Defaults to ~/.claude/projects.
CLAUDE_PROJECTS_DIR=
# The working-documents repository root, for the artifact/document source.
UZA_DOCS_DIR=
# Gmail, read-only. All four blank = the email source reports unconfigured and is skipped.
# Narrow GMAIL_QUERY as far as possible: mail that is never fetched cannot be misfiled.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=
# The advisor and triage. Without it the register still works; the two Claude routes 503.
ANTHROPIC_API_KEY=

# ── First-run only ──────────────────────────────────────────────────────────
# Temporary password applied to the ten seeded accounts. Choose it yourself; the
# seed refuses to run without it and never invents a default. Everyone changes
# theirs on first sign-in, and re-running the seed does NOT reset a changed one.
SEED_PASSWORD=
